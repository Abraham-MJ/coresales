          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"otp\": \"123456\",\n  \"purpose\": \"contract_sign\",\n  \"mark_used\": true\n}"
