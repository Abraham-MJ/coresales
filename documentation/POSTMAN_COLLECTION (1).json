              "host": ["{{base_url}}"],
              "path": ["clients", "by-document"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "document_number", "value": "1234567890" }
              ]
            }
          }
        },
        {
          "name": "Create Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace_id\": \"{{workspace_id}}\",\n  \"client_type\": \"persona_natural\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Cardozo\",\n  \"document_type\": \"CC\",\n  \"document_number\": \"1234567890\",\n  \"email\": \"ana@example.com\",\n  \"phone_code\": \"+57\",\n  \"phone\": \"3007654321\",\n  \"client_status\": \"activo\",\n  \"custom_data\": {\n    \"address\": \"Calle 123 #45-67\"\n  }\n}"
            },
            "url": "{{base_url}}/clients"
          }
        }
      ]
    },
    {
      "name": "7. Contracts",
      "description": "CRUD de contratos",
      "item": [
        {
          "name": "List Contracts (by client)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/contracts?workspace_id={{workspace_id}}&client_id=CLIENT_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["contracts"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "client_id", "value": "CLIENT_ID_HERE" }
