              "raw": "{{base_url}}/clients?workspace_id={{workspace_id}}&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["clients"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Search Client by Document",
          "request": {
