            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace_id\": \"{{workspace_id}}\",\n  \"client_id\": \"CLIENT_ID_HERE\",\n  \"sales_rep_id\": \"{{sales_rep_id}}\",\n  \"total_amount\": 150000,\n  \"items\": [\n    {\n      \"product_id\": \"PLAN_ID_HERE\",\n      \"name\": \"Plan Internet 100Mbps\",\n      \"type\": \"service\",\n      \"quantity\": 1,\n      \"unit_price\": 89000\n    },\n    {\n      \"product_id\": \"PRODUCT_ID_HERE\",\n      \"name\": \"Router WiFi\",\n      \"type\": \"product\",\n      \"quantity\": 1,\n      \"unit_price\": 61000\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/sales"
          }
        }
      ]
    },
    {
      "name": "9. Tasks",
      "description": "Tareas/actividades del vendedor",
      "item": [
