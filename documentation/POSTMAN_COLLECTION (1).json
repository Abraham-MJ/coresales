{
  "info": {
    "name": "NextCore Mobile - Sales Rep App",
    "description": "Colección completa de endpoints para la app móvil de vendedores.\n\nVariables de entorno requeridas:\n- base_url: URL del servidor (ej: http://localhost:3001/api)\n- token: Token de autenticación obtenido en login\n- workspace_id: ID del workspace activo\n- user_id: ID del usuario logueado\n- sales_rep_id: ID del vendedor (obtenido de /sales-reps/me)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001/api" },
    { "key": "token", "value": "" },
    { "key": "workspace_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "sales_rep_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}" }]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Autenticación y recuperación de contraseña",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('workspace_id', res.data.workspace_id);",
                  "  pm.collectionVariables.set('user_id', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@example.com\"\n}"
            },
            "url": "{{base_url}}/auth/forgot-password"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/verify-otp"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewPass123\"\n}"
            },
            "url": "{{base_url}}/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "2. Sales Rep Profile",
      "description": "Perfil y dashboard del vendedor logueado",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('sales_rep_id', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sales-reps/me?workspace_id={{workspace_id}}&user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["sales-reps", "me"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "user_id", "value": "{{user_id}}" }
              ]
            }
          }
        },
        {
          "name": "Get My Dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sales-reps/me/dashboard?workspace_id={{workspace_id}}&user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["sales-reps", "me", "dashboard"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "user_id", "value": "{{user_id}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Wizard Configs",
      "description": "Configuración dinámica de formularios por entity_type",
      "item": [
        {
          "name": "Get Lead Form Config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/wizard-configs/default?workspace_id={{workspace_id}}&entity_type=lead",
              "host": ["{{base_url}}"],
              "path": ["wizard-configs", "default"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "entity_type", "value": "lead" }
              ]
            }
          }
        },
        {
          "name": "Get Client Form Config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/wizard-configs/default?workspace_id={{workspace_id}}&entity_type=client",
              "host": ["{{base_url}}"],
              "path": ["wizard-configs", "default"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "entity_type", "value": "client" }
              ]
            }
          }
        },
        {
          "name": "Get Contract Form Config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/wizard-configs/default?workspace_id={{workspace_id}}&entity_type=contract",
              "host": ["{{base_url}}"],
              "path": ["wizard-configs", "default"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "entity_type", "value": "contract" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Data Sources",
      "description": "Endpoints para poblar campos select/multiselect del wizard",
      "item": [
        {
          "name": "Get ISP Plans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/isp-plans?workspace_id={{workspace_id}}",
              "host": ["{{base_url}}"],
              "path": ["isp-plans"],
              "query": [{ "key": "workspace_id", "value": "{{workspace_id}}" }]
            }
          }
        },
        {
          "name": "Get Products",
