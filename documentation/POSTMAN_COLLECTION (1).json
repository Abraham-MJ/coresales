          }
        },
        {
          "name": "Get Branches",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/branches?workspace_id={{workspace_id}}",
              "host": ["{{base_url}}"],
              "path": ["branches"],
              "query": [{ "key": "workspace_id", "value": "{{workspace_id}}" }]
