            },
            "url": "{{base_url}}/contracts"
          }
        }
      ]
    },
    {
      "name": "8. Sales",
      "description": "CRUD de ventas",
      "item": [
        {
          "name": "List Sales (my sales)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sales?workspace_id={{workspace_id}}&sales_rep_id={{sales_rep_id}}&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["sales"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "sales_rep_id", "value": "{{sales_rep_id}}" },
