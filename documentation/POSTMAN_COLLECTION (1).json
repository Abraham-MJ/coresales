    {
      "name": "13. File Upload",
      "description": "Subida de archivos (firma, fotos)",
      "item": [
        {
          "name": "Upload File (signature/photo)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "workspace_id", "value": "{{workspace_id}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/s3/upload"
          }
        }
      ]
    },
    {
      "name": "14. Workspace",
      "description": "Información del workspace (nombre, logo, moneda, tema)",
      "item": [
        {
          "name": "Get Workspace Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/workspaces?workspace_id={{workspace_id}}",
              "host": ["{{base_url}}"],
              "path": ["workspaces"],
              "query": [{ "key": "workspace_id", "value": "{{workspace_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "15. FTTH — Verificación de Disponibilidad",
      "description": "Endpoints para verificar cobertura FTTH (fibra óptica) en una ubicación. Provider-agnostic: soporta OZmap y otros proveedores.",
      "item": [
        {
          "name": "FTTH Status (¿está configurado?)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ftth/status?workspace_id={{workspace_id}}",
              "host": ["{{base_url}}"],
              "path": ["ftth", "status"],
              "query": [{ "key": "workspace_id", "value": "{{workspace_id}}" }]
            }
          }
        },
        {
          "name": "FTTH Viability (NAPs cercanas)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ftth/viability?workspace_id={{workspace_id}}&lat=4.6097&lng=-74.0817",
              "host": ["{{base_url}}"],
              "path": ["ftth", "viability"],
