          }
        },
        {
          "name": "Get Zones (by branch)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/zones?workspace_id={{workspace_id}}&branch_id=BRANCH_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["zones"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "branch_id", "value": "BRANCH_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Get Clients",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/clients?workspace_id={{workspace_id}}",
              "host": ["{{base_url}}"],
              "path": ["clients"],
              "query": [{ "key": "workspace_id", "value": "{{workspace_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Leads",
      "description": "CRUD de leads",
      "item": [
        {
          "name": "List Leads (my leads)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/leads?workspace_id={{workspace_id}}&sales_rep_id={{sales_rep_id}}&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["leads"],
              "query": [
                { "key": "workspace_id", "value": "{{workspace_id}}" },
                { "key": "sales_rep_id", "value": "{{sales_rep_id}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Lead by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/leads/LEAD_ID_HERE?workspace_id={{workspace_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "LEAD_ID_HERE"],
              "query": [{ "key": "workspace_id", "value": "{{workspace_id}}" }]
            }
          }
        },
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace_id\": \"{{workspace_id}}\",\n  \"sales_rep_id\": \"{{sales_rep_id}}\",\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Perez\",\n  \"email\": \"juan@example.com\",\n  \"phone_code\": \"+57\",\n  \"phone\": \"3001234567\",\n  \"lead_status_id\": \"LEAD_STATUS_UUID_HERE\",\n  \"custom_data\": {\n    \"address\": \"Calle 123\",\n    \"stratum\": 3\n  }\n}"
            },
            "url": "{{base_url}}/leads"
          }
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lead_status_id\": \"NEW_STATUS_UUID_HERE\",\n  \"custom_data\": {\n    \"notes\": \"Contactado por telefono\"\n  }\n}"
            },
            "url": "{{base_url}}/leads/LEAD_ID_HERE"
          }
        }
      ]
    },
    {
      "name": "6. Clients",
      "description": "CRUD de clientes",
      "item": [
        {
          "name": "List Clients",
