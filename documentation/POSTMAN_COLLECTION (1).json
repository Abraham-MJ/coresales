            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"purpose\": \"contract_sign\",\n  \"user_name\": \"Juan Perez\",\n  \"workspace_id\": \"{{workspace_id}}\"\n}"
